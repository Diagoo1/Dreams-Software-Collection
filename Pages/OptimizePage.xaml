<!-- ═════════════════════════════════════════════════════════════════ -->
<!-- ███ FILE: Pages/OptimizePage.xaml - RESPONSIVE DESIGN -->
<!-- ═════════════════════════════════════════════════════════════════ -->

<Page x:Class="Dreams.Pages.OptimizePage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="768" d:DesignWidth="1024" 
      Title="OptimizePage"
      FlowDirection="{DynamicResource ApplicationFlowDirection}"
      Background="Transparent">

    <Page.Resources>
        <!-- ============================================ -->
        <!-- SHADOWS AND EFFECTS                          -->
        <!-- ============================================ -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="0" Opacity="0.08" Color="#000000"/>

        <!-- ============================================ -->
        <!-- ✅ PROFESSIONAL SCROLLBAR STYLE              -->
        <!-- ============================================ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbRect" Background="{DynamicResource DynamicAccent}" CornerRadius="5" Margin="2,0,2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbRect" Property="Background" Value="#0284C7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbRect" Property="Background" Value="#0369A1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- FIXED SIZE LOADING CONTAINER                 -->
        <!-- ============================================ -->
        <Style x:Key="FixedLoadingContainer" TargetType="Border">
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FixedLoadingContainerLarge" TargetType="Border">
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============================================ -->
        <!-- LOADING CIRCLE STYLE - WINDOWS 10 STYLE      -->
        <!-- ============================================ -->
        <Style x:Key="LoadingCircleStyle" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- ============================================ -->
        <!-- SIDEBAR BUTTON STYLE                         -->
        <!-- ============================================ -->
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="SelectionIndicator" HorizontalAlignment="Left" VerticalAlignment="Center" Width="4" Height="20" Background="{DynamicResource DynamicAccent}" CornerRadius="2" Visibility="Collapsed" Margin="2,0,0,0"/>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Margin="8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="54">
                                        <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource DynamicSubText}" x:Name="txtIcon"/>
                                    </Grid>
                                    <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" Margin="5,0,20,0" Foreground="{DynamicResource DynamicMainText}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                                <Setter TargetName="txtIcon" Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                                <Setter TargetName="txtIcon" Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- CLOSE BUTTON STYLE                           -->
        <!-- ============================================ -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicWarning}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AEF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ICON BUTTON STYLE                            -->
        <!-- ============================================ -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- MODERN CARD STYLE                            -->
        <!-- ============================================ -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DynamicCardBg}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DynamicBorder}"/>
        </Style>

        <!-- ============================================ -->
        <!-- TOGGLE SWITCH STYLE                          -->
        <!-- ============================================ -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="border" Width="42" Height="22" CornerRadius="11" Background="{DynamicResource DynamicBorder}"/>
                            <Ellipse x:Name="ellipse" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource DynamicAccent}"/>
                                <Setter TargetName="ellipse" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="ellipse" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ACTION BUTTON STYLE                          -->
        <!-- ============================================ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DynamicAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- OK BUTTON STYLE                              -->
        <!-- ============================================ -->
        <Style x:Key="OkButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DynamicSuccess}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="25,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- MODERN CLEANER CHECKBOX STYLE                -->
        <!-- ============================================ -->
        <Style x:Key="CleanerCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="FullRowLayout" Background="Transparent" CornerRadius="8" Padding="12,8" Margin="-8,0">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Grid Grid.Column="1">
                                    <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" BorderBrush="{DynamicResource DynamicBorder}" Background="Transparent"/>
                                    <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FullRowLayout" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource DynamicAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource DynamicAccent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource DynamicAccent}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- PROGRESS BAR STYLE                           -->
        <!-- ============================================ -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource DynamicBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- SIZE TEXT BLOCK STYLE                        -->
        <!-- ============================================ -->
        <Style x:Key="SizeTextBlock" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Visibility" Value="Visible"/>
        </Style>

        <!-- ============================================ -->
        <!-- ANIMATIONS                                   -->
        <!-- ============================================ -->
        <Storyboard x:Key="OpenSidebar">
            <DoubleAnimation Storyboard.TargetName="sideBar" Storyboard.TargetProperty="Width" To="220" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="CloseSidebar">
            <DoubleAnimation Storyboard.TargetName="sideBar" Storyboard.TargetProperty="Width" To="70" Duration="0:0:0.3"/>
        </Storyboard>
    </Page.Resources>

    <!-- ============================================ -->
    <!-- MAIN LAYOUT                                  -->
    <!-- ============================================ -->
    <Border Background="{DynamicResource DynamicWindowBg}" CornerRadius="20" BorderBrush="{DynamicResource DynamicBorder}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR (مخفي - موجود في MainWindow) -->
            <Border x:Name="sideBar" Visibility="Collapsed" Background="{DynamicResource DynamicCardBg}" Width="70" CornerRadius="20,0,0,20" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DynamicBorderBrush}"/>

            <!-- ============================================ -->
            <!-- MAIN CONTENT - RESPONSIVE LAYOUT           -->
            <!-- ============================================ -->
            <Grid Grid.Column="1" Margin="15,10,15,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Margin="5,0,5,10">
                    <TextBlock x:Name="lblGreeting" Text="{DynamicResource SystemOptimizer}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}" VerticalAlignment="Center"/>
                </Grid>

                <!-- STATS CARDS - Responsive Grid -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- RAM CARD -->
                    <Border Style="{StaticResource ModernCard}" Grid.Column="0" Margin="0,0,6,0" Padding="14">
                        <Grid>
                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="50" Foreground="{DynamicResource DynamicPurple}" Opacity="0.06" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#208B5CF6" Width="36" Height="36" CornerRadius="10">
                                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DynamicPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource RAMUsage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DynamicSubText}" Margin="10,0,0,6" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock x:Name="lblRamUsage" Text="--/--" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}"/>
                                <ProgressBar x:Name="prgRam" Style="{StaticResource ModernProgressBar}" Margin="0,8,0,0" Foreground="{DynamicResource DynamicPurple}" Value="0"/>
                                <TextBlock x:Name="lblRamPercent" Text="0% used" FontSize="9" Foreground="{DynamicResource DynamicSubText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button x:Name="btnBoostRam" Content="{DynamicResource BOOST}" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ActionBtn}" Background="{DynamicResource DynamicPurple}" Click="btnBoostRam_Click"/>
                        </Grid>
                    </Border>

                    <!-- DISK CARD -->
                    <Border Style="{StaticResource ModernCard}" Grid.Column="1" Margin="3,0" Padding="14">
                        <Grid>
                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="50" Foreground="{DynamicResource DynamicWarning}" Opacity="0.06" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#20F97316" Width="36" Height="36" CornerRadius="10">
                                        <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DynamicWarning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource DiskSpace}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DynamicSubText}" Margin="10,0,0,6" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock x:Name="lblDiskSpace" Text="--/--" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}"/>
                                <ProgressBar x:Name="prgDisk" Style="{StaticResource ModernProgressBar}" Margin="0,8,0,0" Foreground="{DynamicResource DynamicWarning}" Value="0"/>
                                <TextBlock x:Name="lblDiskPercent" Text="0% used" FontSize="9" Foreground="{DynamicResource DynamicSubText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button x:Name="btnAnalyzeDisk" Content="{DynamicResource ANALYZE}" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ActionBtn}" Background="{DynamicResource DynamicWarning}" Click="btnAnalyzeDisk_Click"/>
                        </Grid>
                    </Border>

                    <!-- STARTUP CARD -->
                    <Border Style="{StaticResource ModernCard}" Grid.Column="2" Margin="6,0,0,0" Padding="14">
                        <Grid>
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="50" Foreground="{DynamicResource DynamicPink}" Opacity="0.06" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#20EC4899" Width="36" Height="36" CornerRadius="10">
                                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DynamicPink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource StartupImpact}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DynamicSubText}" Margin="10,0,0,6" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="lblStartupCount" Text="--" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}"/>
                                    <TextBlock Text="{DynamicResource Programs}" FontSize="12" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                                <ProgressBar x:Name="prgStartup" Style="{StaticResource ModernProgressBar}" Margin="0,8,0,0" Foreground="{DynamicResource DynamicPink}" Value="0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Border x:Name="startupImpactDot" Width="7" Height="7" CornerRadius="4" Background="{DynamicResource DynamicPink}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="lblStartupDesc" Text="{DynamicResource Scanning}" FontSize="9" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="btnManageStartup" Content="{DynamicResource MANAGE}" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ActionBtn}" Background="{DynamicResource DynamicPink}" Click="btnManageStartup_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================ -->
                <!-- MAIN CONTENT: Cleaning Categories + Analyzer -->
                <!-- ============================================ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: CLEANING CATEGORIES -->
                    <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="0" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="18,12,18,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource CleaningCategories}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}" Grid.Column="0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource SelectAll}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="chkSelectAll" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Separator Grid.Row="0" Background="{DynamicResource DynamicBorder}" Margin="18,48,18,0"/>

                            <!-- ✅ Smart ScrollViewer with professional scrollbar -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                                <StackPanel Margin="0,3,0,3">

                                    <!-- SYSTEM CLEANER SECTION -->
                                    <Border BorderBrush="{DynamicResource DynamicBorder}" BorderThickness="0,0,0,1" Margin="12,6">
                                        <StackPanel>
                                            <Grid Margin="12,10,12,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#15EF4444" CornerRadius="9" Width="32" Height="32">
                                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicWarning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource SystemCleaner}" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}"/>
                                                    <TextBlock Text="{DynamicResource TempFilesLogsCache}" FontSize="10" Foreground="{DynamicResource DynamicSubText}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource FixedLoadingContainer}" Margin="0,0,12,0">
                                                    <Grid>
                                                        <TextBlock x:Name="lblSystemSize" Style="{StaticResource SizeTextBlock}" Foreground="{DynamicResource DynamicWarning}" Text="0 MB"/>
                                                        <Border x:Name="loadingSystemSize" Style="{StaticResource LoadingCircleStyle}" Background="{DynamicResource DynamicWarning}"/>
                                                    </Grid>
                                                </Border>
                                                <CheckBox x:Name="chkSystemMaster" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel x:Name="panelSystemOptions" Margin="42,0,12,12">
                                                <CheckBox x:Name="chkTempFiles" Content="{DynamicResource TemporaryFiles}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkAppDataTemp" Content="{DynamicResource AppDataTemp}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkRecycleBin" Content="{DynamicResource EmptyRecycleBin}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkErrorReports" Content="{DynamicResource MemoryDumps}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkThumbnails" Content="{DynamicResource ChkdskFileFragments}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkWinUpdate" Content="{DynamicResource WindowsUpdateCache}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkWindowsLogs" Content="{DynamicResource WindowsLogFiles}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkEventLogs" Content="{DynamicResource WindowsEventTraceLogs}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkDnsCache" Content="{DynamicResource DNSCache}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkStartMenu" Content="{DynamicResource StartMenuShortcuts}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkDesktop" Content="{DynamicResource DesktopShortcuts}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkDriverLogs" Content="{DynamicResource DriverInstallationLogs}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkDeliveryOpt" Content="{DynamicResource WindowsDeliveryOptimization}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkNotifications" Content="{DynamicResource WindowsNotifications}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkNetworkUsage" Content="{DynamicResource NetworkDataUsage}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkWebCache" Content="{DynamicResource WindowsWebCache}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- BROWSER CLEANER SECTION -->
                                    <Border BorderBrush="{DynamicResource DynamicBorder}" BorderThickness="0,0,0,1" Margin="12,6">
                                        <StackPanel>
                                            <Grid Margin="12,10,12,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#158B5CF6" CornerRadius="9" Width="32" Height="32">
                                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource BrowserCleaner}" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}"/>
                                                    <TextBlock Text="{DynamicResource ChromeEdgeFirefoxData}" FontSize="10" Foreground="{DynamicResource DynamicSubText}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource FixedLoadingContainer}" Margin="0,0,12,0">
                                                    <Grid>
                                                        <TextBlock x:Name="lblBrowserSize" Style="{StaticResource SizeTextBlock}" Foreground="{DynamicResource DynamicPurple}" Text="0 MB"/>
                                                        <Border x:Name="loadingBrowserSize" Style="{StaticResource LoadingCircleStyle}" Background="{DynamicResource DynamicPurple}"/>
                                                    </Grid>
                                                </Border>
                                                <CheckBox x:Name="chkBrowserMaster" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel x:Name="panelBrowserOptions" Margin="42,0,12,12">
                                                <CheckBox x:Name="chkBrowserCache" Content="{DynamicResource BrowserCache}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkBrowserHistory" Content="{DynamicResource BrowsingHistory}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkCookies" Content="{DynamicResource CookiesSiteData}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkDownloads" Content="{DynamicResource DownloadHistory}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkPasswords" Content="{DynamicResource SavedPasswords}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkFormData" Content="{DynamicResource FormDataAutofill}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkLocalStorage" Content="{DynamicResource LocalStorageSession}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkServiceWorkers" Content="{DynamicResource ServiceWorkers}" Style="{StaticResource CleanerCheckBox}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- APPLICATION CLEANER SECTION -->
                                    <Border BorderBrush="{DynamicResource DynamicBorder}" BorderThickness="0,0,0,1" Margin="12,6">
                                        <StackPanel>
                                            <Grid Margin="12,10,12,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#15F97316" CornerRadius="9" Width="32" Height="32">
                                                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicWarning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource ApplicationCleaner}" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}"/>
                                                    <TextBlock Text="{DynamicResource AppCachesLogsTemp}" FontSize="10" Foreground="{DynamicResource DynamicSubText}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource FixedLoadingContainer}" Margin="0,0,12,0">
                                                    <Grid>
                                                        <TextBlock x:Name="lblAppSize" Style="{StaticResource SizeTextBlock}" Foreground="{DynamicResource DynamicWarning}" Text="0 MB"/>
                                                        <Border x:Name="loadingAppSize" Style="{StaticResource LoadingCircleStyle}" Background="{DynamicResource DynamicWarning}"/>
                                                    </Grid>
                                                </Border>
                                                <CheckBox x:Name="chkAppMaster" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel x:Name="panelAppOptions" Margin="42,0,12,12">
                                                <CheckBox x:Name="chkAppCache" Content="{DynamicResource ApplicationCache}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkAppLogs" Content="{DynamicResource ApplicationLogs}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkAppTemp" Content="{DynamicResource ApplicationTempFiles}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkOldPrefetch" Content="{DynamicResource OldPrefetchData}" Style="{StaticResource CleanerCheckBox}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- REGISTRY CLEANER SECTION -->
                                    <Border BorderBrush="{DynamicResource DynamicBorder}" BorderThickness="0,0,0,1" Margin="12,6">
                                        <StackPanel>
                                            <Grid Margin="12,10,12,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#150EA5E9" CornerRadius="9" Width="32" Height="32">
                                                    <TextBlock Text="&#xE8B3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource RegistryCleaner}" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}"/>
                                                    <TextBlock Text="{DynamicResource InvalidEntriesMissingDLLs}" FontSize="10" Foreground="{DynamicResource DynamicSubText}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" MinWidth="90" MinHeight="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <Grid>
                                                        <TextBlock x:Name="lblRegistrySize" Style="{StaticResource SizeTextBlock}" Foreground="{DynamicResource DynamicAccent}" Text="0 items"/>
                                                        <Border x:Name="loadingRegistrySize" Style="{StaticResource LoadingCircleStyle}" Background="{DynamicResource DynamicAccent}"/>
                                                    </Grid>
                                                </Border>
                                                <CheckBox x:Name="chkRegistryMaster" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel x:Name="panelRegistryOptions" Margin="42,0,12,12">
                                                <CheckBox x:Name="chkRegistryInvalid" Content="{DynamicResource InvalidFileAssociations}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkRegistryDLL" Content="{DynamicResource MissingDLLEntries}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkRegistryEmpty" Content="{DynamicResource EmptyRegistryKeys}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkRegistryUninstall" Content="{DynamicResource OldUninstallerEntries}" Style="{StaticResource CleanerCheckBox}"/>
                                                <CheckBox x:Name="chkRegistryAppPaths" Content="{DynamicResource ApplicationPaths}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkRegistryTypeLib" Content="{DynamicResource TypeLibraries}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkRegistryObsolete" Content="{DynamicResource ObsoleteSoftware}" Style="{StaticResource CleanerCheckBox}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- PRIVACY CLEANER SECTION -->
                                    <Border BorderBrush="{DynamicResource DynamicBorder}" BorderThickness="0,0,0,1" Margin="12,6">
                                        <StackPanel>
                                            <Grid Margin="12,10,12,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#1514B8A6" CornerRadius="9" Width="32" Height="32">
                                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicTeal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource PrivacyCleaner}" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}"/>
                                                    <TextBlock Text="{DynamicResource RecentDocsClipboardSearch}" FontSize="10" Foreground="{DynamicResource DynamicSubText}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource FixedLoadingContainer}" Margin="0,0,12,0">
                                                    <Grid>
                                                        <TextBlock x:Name="lblPrivacySize" Style="{StaticResource SizeTextBlock}" Foreground="{DynamicResource DynamicTeal}" Text="0 MB"/>
                                                        <Border x:Name="loadingPrivacySize" Style="{StaticResource LoadingCircleStyle}" Background="{DynamicResource DynamicTeal}"/>
                                                    </Grid>
                                                </Border>
                                                <CheckBox x:Name="chkPrivacyMaster" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel x:Name="panelPrivacyOptions" Margin="42,0,12,12">
                                                <CheckBox x:Name="chkRecentDocs" Content="{DynamicResource RecentDocuments}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkRunHistory" Content="{DynamicResource RunHistory}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkClipboard" Content="{DynamicResource ClipboardData}" Style="{StaticResource CleanerCheckBox}" IsChecked="True"/>
                                                <CheckBox x:Name="chkSearchHistory" Content="{DynamicResource SearchHistory}" Style="{StaticResource CleanerCheckBox}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- RIGHT: DISK ANALYZER + CLEAN BUTTON -->
                    <StackPanel Grid.Column="1">
                        <!-- DISK ANALYZER CARD -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,10" Height="230">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#1514B8A6" Width="32" Height="32" CornerRadius="9">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicTeal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource DiskAnalyzer}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6" HorizontalAlignment="Center">
                                        <Border Width="14" Height="14" CornerRadius="3" Background="#EF4444" Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource SystemFiles}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" Width="90"/>
                                        <TextBlock x:Name="lblSystemPercent" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#EF4444" Width="45" TextAlignment="Right"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6" HorizontalAlignment="Center">
                                        <Border Width="14" Height="14" CornerRadius="3" Background="#8B5CF6" Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource BrowserData}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" Width="90"/>
                                        <TextBlock x:Name="lblBrowserPercent" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#8B5CF6" Width="45" TextAlignment="Right"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6" HorizontalAlignment="Center">
                                        <Border Width="14" Height="14" CornerRadius="3" Background="#F97316" Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource AppData}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" Width="90"/>
                                        <TextBlock x:Name="lblAppPercent" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#F97316" Width="45" TextAlignment="Right"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6" HorizontalAlignment="Center">
                                        <Border Width="14" Height="14" CornerRadius="3" Background="#0EA5E9" Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource Registry}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" Width="90"/>
                                        <TextBlock x:Name="lblRegistryPercent" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#0EA5E9" Width="45" TextAlignment="Right"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6" HorizontalAlignment="Center">
                                        <Border Width="14" Height="14" CornerRadius="3" Background="#14B8A6" Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource Privacy}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" Width="90"/>
                                        <TextBlock x:Name="lblPrivacyPercent" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#14B8A6" Width="45" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SUMMARY CARD -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Border Background="#15EF4444" Width="36" Height="36" CornerRadius="10">
                                        <TextBlock Text="&#xEA99;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource DynamicWarning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource CleanupSummary}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>

                                <Border x:Name="totalCardBorder" Background="{DynamicResource DynamicTotalCardBg}" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderThickness="1" BorderBrush="{DynamicResource DynamicBorder}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource TOTALCLEANING}" FontSize="10" Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Center"/>
                                        <Border Style="{StaticResource FixedLoadingContainerLarge}" Margin="0,4,0,0">
                                            <Grid>
                                                <TextBlock x:Name="lblTotalRecoverable" Text="0 MB" FontSize="26" FontWeight="ExtraBold" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border x:Name="loadingTotalSize" Style="{StaticResource LoadingCircleStyle}" Background="{DynamicResource DynamicAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="btnRunOptimization" Content="{DynamicResource RUNOPTIMIZATION}" Background="{DynamicResource DynamicAccent}" Foreground="White" Cursor="Hand" Height="40" FontWeight="Bold" FontSize="12" BorderThickness="0" Click="btnRunOptimization_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="14,10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource DynamicPurple}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource DynamicIndigo}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Effect>
                                        <DropShadowEffect Color="#0EA5E9" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity="0.3"/>
                                    </Button.Effect>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- PROGRESS SECTION -->
                <Border x:Name="progressSection" Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,8,0,0" Visibility="Collapsed" BorderBrush="{DynamicResource DynamicAccent}" BorderThickness="2" Grid.ColumnSpan="2">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource DynamicAccent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource CleaningInProgress}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource DynamicMainText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="lblProgressPercent" Text="0%" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar x:Name="progressBar" Style="{StaticResource ModernProgressBar}" Minimum="0" Maximum="100" Value="0"/>
                        <TextBlock x:Name="lblProgressText" Text="{DynamicResource Preparing}" FontSize="10" Foreground="{DynamicResource DynamicSubText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- RESULTS SECTION -->
                <Border x:Name="resultsSection" Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,8,0,0" Visibility="Collapsed" BorderBrush="{DynamicResource DynamicSuccess}" BorderThickness="2" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DynamicSuccess}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblResultTitle" Text="{DynamicResource CleaningComplete}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource DynamicSuccess}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer x:Name="resultsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8" MaxHeight="260">
                            <TextBlock x:Name="lblResultsText" Text="" FontSize="12" Foreground="{DynamicResource DynamicMainText}" TextWrapping="Wrap" LineHeight="20"/>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2">
                            <Border Background="#1522C55E" CornerRadius="9" Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC61;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource DynamicSuccess}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource SpaceFreed}" FontSize="12" Foreground="{DynamicResource DynamicSuccess}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblSpaceFreed" Text="" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DynamicSuccess}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="btnCloseResults" Content="{DynamicResource OK}" Style="{StaticResource OkButton}" HorizontalAlignment="Center" Width="90" Click="btnCloseResults_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Page>