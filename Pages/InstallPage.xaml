<Page x:Class="Dreams.Pages.InstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="768" d:DesignWidth="1024"
      Title="InstallPage"
      FlowDirection="{DynamicResource ApplicationFlowDirection}"
      Background="Transparent">

    <Page.Resources>
        <FontFamily x:Key="ApplicationFont">Segoe UI</FontFamily>

        <!-- ============================================ -->
        <!-- BUTTON STYLES (Start/Stop/Resume/Done)       -->
        <!-- ============================================ -->
        <Style x:Key="StartBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0EA5E9" Offset="0"/>
                        <GradientStop Color="#0284C7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Tag" Value="&#xE768;"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0284C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StopBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EF4444" Offset="0"/>
                        <GradientStop Color="#B91C1C" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Tag" Value="&#xE71A;"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResumeBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F59E0B" Offset="0"/>
                        <GradientStop Color="#B45309" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Tag" Value="&#xE769;"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B45309"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DoneBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#22C55E" Offset="0"/>
                        <GradientStop Color="#15803D" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Tag" Value="&#xE73E;"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernBtn" TargetType="Button" BasedOn="{StaticResource StartBtn}"/>

        <!-- SELECT ALL BUTTON -->
        <Style x:Key="SelectBtnInverted" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DynamicAccent}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Width" Value="104"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CHECKBOX STYLE -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder" Width="18" Height="18" CornerRadius="4" Background="{DynamicResource DynamicCardBg}" BorderThickness="2" BorderBrush="{DynamicResource DynamicBorderBrush}" VerticalAlignment="Center">
                                <TextBlock x:Name="CheckMark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource DynamicAccent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource DynamicAccent}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource DynamicAccent}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxBorder" Property="Opacity" Value="0.3"/>
                                <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ CATEGORY TAB STYLE (مأخوذ من OnlinePage) -->
        <Style x:Key="CategoryTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1.5"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="bd" Property="Background" Value="#1A0EA5E9"/>
                                <Setter Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ QUEUE BUTTON (Quick Menu) -->
        <Style x:Key="QueueBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DynamicBorderBrush}"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource DynamicAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SCROLLBAR -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbRect" Background="{StaticResource AccentGradient}" CornerRadius="5" Margin="2,0,2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbRect" Property="Background" Value="#0284C7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PROGRESS BAR -->
        <!-- PROGRESS BAR (بدون لمعة) -->
        <Style x:Key="CustomProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Value" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource DynamicBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <!-- الخلفية -->
                            <Border x:Name="PART_Track" CornerRadius="14"
                            Background="{TemplateBinding Background}"/>

                            <!-- ✅ الإندكاتر فقط بدون لمعة -->
                            <Border CornerRadius="14" ClipToBounds="True"
                            HorizontalAlignment="Stretch">
                                <Grid HorizontalAlignment="Left"
                              Width="{TemplateBinding Width}">
                                    <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#0EA5E9" Offset="0.0"/>
                                                <GradientStop Color="#3B82F6" Offset="0.5"/>
                                                <GradientStop Color="#8B5CF6" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- نص النسبة -->
                            <TextBlock x:Name="PercentText"
                               Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}%}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PercentText" Property="Foreground"
                                Value="{DynamicResource DynamicMainText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- ============================================ -->
    <!-- ROOT LAYOUT (Modern Tabs + WrapPanel)        -->
    <!-- ============================================ -->
    <Border Background="{DynamicResource DynamicWindowBg}" CornerRadius="20"
            BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1">
        <Grid x:Name="MainContent" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- ✨ Category Tabs (جديد) -->
                <RowDefinition Height="*"/>
                <!-- Programs Area -->
                <RowDefinition Height="Auto"/>
                <!-- Bottom Bar -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="10,0,10,15">
                <TextBlock x:Name="lblGreeting"
                           Text="{DynamicResource SoftwareInstaller}"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource DynamicMainText}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- ✅ CATEGORY TABS (مع سحب أفقي + Mouse Wheel) -->
            <!-- ✅ CATEGORY TABS مع خلفية (مثل OnlinePage) -->
            <Border Grid.Row="1"
        Background="{DynamicResource DynamicTotalCardBg}" 
        CornerRadius="8" 
        Padding="4,4" 
        HorizontalAlignment="Left" 
        Margin="0,4,0,15">

                <ScrollViewer x:Name="CategoryTabsScroll"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled"
                  PanningMode="HorizontalOnly"
                  CanContentScroll="False"
                  Cursor="Hand"
                  PreviewMouseWheel="CategoryTabsScroll_PreviewMouseWheel"
                  PreviewMouseLeftButtonDown="CategoryTabsScroll_MouseDown"
                  PreviewMouseMove="CategoryTabsScroll_MouseMove"
                  PreviewMouseLeftButtonUp="CategoryTabsScroll_MouseUp"
                  MouseLeave="CategoryTabsScroll_MouseUp">

                    <StackPanel x:Name="CategoryTabsPanel"
                    Orientation="Horizontal"
                    Margin="2,0,2,0"/>
                </ScrollViewer>
            </Border>

            <!-- ✅ PROGRAMS AREA (عمود واحد + WrapPanel للأقسام) -->
            <ScrollViewer Grid.Row="2"
                          x:Name="AppsScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          SizeChanged="AppsScrollViewer_SizeChanged">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="Col1Def" Width="*"/>
                        <ColumnDefinition x:Name="Col2Def" Width="0"/>
                        <ColumnDefinition x:Name="Col3Def" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <ItemsControl x:Name="Column1Container" Grid.Column="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl x:Name="Column2Container" Grid.Column="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl x:Name="Column3Container" Grid.Column="2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- BOTTOM ACTION BAR (مع زر Quick Menu) -->
            <Border Grid.Row="3" Background="{DynamicResource DynamicCardBg}"
                    CornerRadius="15" Padding="15" Margin="0,15,0,0"
                    BorderThickness="1" BorderBrush="{DynamicResource DynamicBorderBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="installProgressBar" Grid.Column="0"
                                     Style="{StaticResource CustomProgressBar}"
                                     Value="0" Margin="0,0,15,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource DynamicAccent}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblTimer" Text="00:00:00"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource DynamicMainText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DynamicBorderBrush}"
                            Margin="-15,5,-15,20" Opacity="0.6"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Select All + Counter -->
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnSelectAll"
                                    Content="{DynamicResource SelectAll}"
                                    Style="{StaticResource SelectBtnInverted}"
                                    Click="btnSelectAll_Click"
                                    Width="120"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,8"/>

                            <Rectangle Grid.Column="1" Width="1" Height="30"
                                       Fill="{DynamicResource DynamicBorderBrush}"
                                       Margin="15,0"/>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="70">
                                <TextBlock Text="{DynamicResource Selected}"
                                           FontSize="9" FontWeight="ExtraBold"
                                           Foreground="{DynamicResource DynamicSubText}"
                                           TextAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="lblTotalAppsCount" Text="0"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource DynamicAccent}"/>
                                    <TextBlock Text="/" FontSize="12"
                                               Foreground="{DynamicResource DynamicSubText}"
                                               Margin="3,2,3,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblTotalApps" Text="0" FontSize="12"
                                               Foreground="{DynamicResource DynamicSubText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Center: Main Action Button -->
                        <Button x:Name="btnStart" Grid.Column="1"
                                Content="Start"
                                Style="{StaticResource StartBtn}"
                                Width="240" Height="50"
                                Click="btnStart_Click"/>

                        <!-- ✅ Right: Quick Menu + Status -->
                        <Grid Grid.Column="2" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Width="280">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnQueueList" Grid.Column="0"
                                    Style="{StaticResource QueueBtn}"
                                    Click="btnQueueList_Click"
                                    Margin="0,0,10,0"
                                    ToolTip="{DynamicResource QueueListTooltip}"/>

                            <Rectangle Grid.Column="1" Width="1" Height="30"
                                       Fill="{DynamicResource DynamicBorderBrush}"
                                       Margin="0,0,10,0"/>

                            <Border x:Name="statusIconBorder" Grid.Column="2"
                                    Background="{DynamicResource DynamicBorderBrush}"
                                    Width="36" Height="36" CornerRadius="10">
                                <TextBlock x:Name="statusIconText" Text="&#xE81E;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource DynamicAccent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource CurrentStatus}"
                                           FontSize="9" FontWeight="ExtraBold"
                                           Foreground="{DynamicResource DynamicSubText}"/>
                                <TextBlock x:Name="lblStatusText"
                                           Text="{DynamicResource ReadyToStart}"
                                           FontSize="13"
                                           Foreground="{DynamicResource DynamicMainText}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Height="20"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Page>