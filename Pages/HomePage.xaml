<!-- ═════════════════════════════════════════════════════════════════ -->
<!-- ███ FILE: Pages/HomePage.xaml - RESPONSIVE + PROFESSIONAL SCROLL -->
<!-- ═════════════════════════════════════════════════════════════════ -->

<Page x:Class="Dreams.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1024"
      Title="{DynamicResource SystemDashboard}"
      FlowDirection="{DynamicResource ApplicationFlowDirection}"
      Background="Transparent">

    <Page.Resources>

        <!-- ============================================ -->
        <!-- PROFESSIONAL SCROLLBAR STYLE                 -->
        <!-- ============================================ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbRect"
                                                        Background="{DynamicResource DynamicAccent}"
                                                        CornerRadius="5"
                                                        Margin="2,0,2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbRect" Property="Background" Value="#0284C7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbRect" Property="Background" Value="#0369A1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- GRADIENT FOR MODERN BUTTON                   -->
        <!-- ============================================ -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#0284C7" Offset="1"/>
        </LinearGradientBrush>

        <!-- ============================================ -->
        <!-- STYLE - ICON BOX                             -->
        <!-- ============================================ -->
        <Style x:Key="IconBox" TargetType="Border">
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- ============================================ -->
        <!-- STYLE - FIELD LABEL                          -->
        <!-- ============================================ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============================================ -->
        <!-- STYLE - FIELD VALUE                          -->
        <!-- ============================================ -->
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="10,2,0,2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============================================ -->
        <!-- STYLE - MODERN GRADIENT BUTTON               -->
        <!-- ============================================ -->
        <Style x:Key="ModernGradientBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- STYLE - TOGGLE BUTTON (EYE FOR IP)           -->
        <!-- ============================================ -->
        <Style x:Key="ToggleEyeButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <TextBlock x:Name="icon"
                                       Text="&#xED1A;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="icon" Property="Text" Value="&#xE7B3;"/>
                                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <!-- ============================================ -->
    <!-- MAIN CONTENT BORDER                          -->
    <!-- ============================================ -->
    <Border Background="{DynamicResource DynamicWindowBg}"
            CornerRadius="20"
            BorderBrush="{DynamicResource DynamicBorderBrush}"
            BorderThickness="1">
        <Grid>

            <!-- SIDEBAR PLACEHOLDER (مخفي - موجود في MainWindow) -->
            <Border x:Name="sideBar"
                    Visibility="Collapsed"
                    Background="{DynamicResource DynamicCardBg}"
                    Width="70"
                    CornerRadius="20,0,0,20"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource DynamicBorderBrush}"/>

            <!-- ============================================ -->
            <!-- MAIN CONTENT                                 -->
            <!-- ============================================ -->
            <Grid x:Name="MainContent" Margin="15,10,15,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── HEADER ── -->
                <Grid Grid.Row="0" Margin="5,0,5,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- ✅ نص التحية العادي (Good Morning/Afternoon/Evening,) -->
                        <TextBlock x:Name="lblGreetingPrefix"
                   Text="{DynamicResource SystemDashboard}"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource DynamicMainText}"
                   VerticalAlignment="Center"/>

                        <!-- ✅ اسم اليوزر بـ Gradient واضح وحاد (بدون شادو) -->
                        <TextBlock x:Name="lblUserName"
           Text=""
           FontSize="20"
           FontWeight="Bold"
           VerticalAlignment="Center"
           Margin="6,0,0,0"
           UseLayoutRounding="True"
           SnapsToDevicePixels="True"
           TextOptions.TextRenderingMode="ClearType"
           TextOptions.TextFormattingMode="Display">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0EA5E9" Offset="0"/>
                                    <GradientStop Color="#3B82F6" Offset="0.5"/>
                                    <GradientStop Color="#8B5CF2" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <!-- ✅ أيقونة اليد بنفس خط المشروع (Segoe MDL2 Assets) -->
                        <TextBlock x:Name="lblGreetingIcon"
                   Text="&#xEB51;"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="18"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0EA5E9" Offset="0"/>
                                    <GradientStop Color="#8B5CF2" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <!-- لخفاء الـ TextBlock القديم - مش هنحتاجه -->
                        <TextBlock x:Name="lblGreeting" Visibility="Collapsed"/>

                    </StackPanel>
                </Grid>

                <!-- ── SCROLLABLE CONTENT ── -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>

                        <!-- ════════════════════════════════════════ -->
                        <!-- ROW 1 ▸ RAM + DISK CARDS                 -->
                        <!-- ════════════════════════════════════════ -->
                        <UniformGrid Columns="2" Margin="0,0,0,12">

                            <!-- ── RAM CARD ── -->
                            <Border Background="{DynamicResource DynamicCardBg}"
                                    CornerRadius="14"
                                    Margin="5"
                                    Padding="14"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DynamicBorderBrush}">
                                <Grid>

                                    <!-- Info -->
                                    <StackPanel VerticalAlignment="Center"
                                                Margin="0,0,90,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Style="{StaticResource IconBox}"
                                                    Background="#1522C55E">
                                                <TextBlock Text="&#xE169;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{DynamicResource DynamicSuccess}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="16"/>
                                            </Border>
                                            <TextBlock Text="{DynamicResource MemoryRAM}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource DynamicMainText}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"/>
                                        </StackPanel>

                                        <TextBlock FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DynamicMainText}">
                                            <Run Text="{DynamicResource Used}"/>:
                                            <Run x:Name="lblRamUsed" Text="--"/>
                                        </TextBlock>

                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource DynamicSubText}"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap">
                                            <Run Text="{DynamicResource Total}"/>:
                                            <Run x:Name="lblRamTotal" Text="--"/>
                                            <Run Text="{DynamicResource GB}"/>
                                            <Run Text="|"/>
                                            <Run Text="{DynamicResource Free}"/>:
                                            <Run x:Name="lblRamFree" Text="--"/>
                                            <Run Text="{DynamicResource GB}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- WPF-UI Arc — RAM -->
                                    <Grid HorizontalAlignment="Right"
                                          Width="80"
                                          Height="80">

                                        <!-- الدائرة الخلفية الكاملة (الحدود الرمادية) -->
                                        <Ellipse Width="72"
                                                 Height="72"
                                                 Stroke="{DynamicResource DynamicBorderBrush}"
                                                 StrokeThickness="8"
                                                 Fill="Transparent"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                                        <!-- Progress Arc - الجزء الملون -->
                                        <ui:Arc x:Name="ramArc"
                                                Width="72"
                                                Height="72"
                                                StartAngle="0"
                                                EndAngle="1"
                                                StrokeThickness="8"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                                Fill="Transparent"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <ui:Arc.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#22C55E" Offset="0"/>
                                                    <GradientStop Color="#16A34A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </ui:Arc.Stroke>
                                        </ui:Arc>

                                        <!-- Percentage Text -->
                                        <TextBlock x:Name="lblRamPerc"
                                                   Text="--%"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource DynamicMainText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                </Grid>
                            </Border>

                            <!-- ── DISK CARD ── -->
                            <Border Background="{DynamicResource DynamicCardBg}"
                                    CornerRadius="14"
                                    Margin="5"
                                    Padding="14"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DynamicBorderBrush}">
                                <Grid>

                                    <!-- Info -->
                                    <StackPanel VerticalAlignment="Center"
                                                Margin="0,0,90,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Style="{StaticResource IconBox}"
                                                    Background="#15F97316">
                                                <TextBlock Text="&#xEDA2;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{DynamicResource DynamicInfo}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="16"/>
                                            </Border>
                                            <TextBlock x:Name="lblDriveTitle"
                                                       Text="{DynamicResource SystemDisk}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource DynamicMainText}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"/>
                                        </StackPanel>

                                        <TextBlock FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DynamicMainText}">
                                            <Run Text="{DynamicResource Used}"/>:
                                            <Run x:Name="lblDiskUsed" Text="--"/>
                                        </TextBlock>

                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource DynamicSubText}"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap">
                                            <Run Text="{DynamicResource Total}"/>:
                                            <Run x:Name="lblDiskTotal" Text="--"/>
                                            <Run Text="{DynamicResource GB}"/>
                                            <Run Text="|"/>
                                            <Run Text="{DynamicResource Free}"/>:
                                            <Run x:Name="lblDiskFree" Text="--"/>
                                            <Run Text="{DynamicResource GB}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- WPF-UI Arc — Disk -->
                                    <Grid HorizontalAlignment="Right"
                                          Width="80"
                                          Height="80">

                                        <!-- الدائرة الخلفية الكاملة (الحدود الرمادية) -->
                                        <Ellipse Width="72"
                                                 Height="72"
                                                 Stroke="{DynamicResource DynamicBorderBrush}"
                                                 StrokeThickness="8"
                                                 Fill="Transparent"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                                        <!-- Progress Arc - الجزء الملون -->
                                        <ui:Arc x:Name="diskArc"
                                                Width="72"
                                                Height="72"
                                                StartAngle="0"
                                                EndAngle="1"
                                                StrokeThickness="8"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                                Fill="Transparent"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <ui:Arc.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#F97316" Offset="0"/>
                                                    <GradientStop Color="#EA580C" Offset="1"/>
                                                </LinearGradientBrush>
                                            </ui:Arc.Stroke>
                                        </ui:Arc>

                                        <!-- Percentage Text -->
                                        <TextBlock x:Name="lblDiskPerc"
                                                   Text="--%"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource DynamicMainText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                </Grid>
                            </Border>

                        </UniformGrid>

                        <!-- ════════════════════════════════════════ -->
                        <!-- ROW 2 ▸ CPU + GPU + DISPLAY CARDS        -->
                        <!-- ════════════════════════════════════════ -->
                        <UniformGrid Columns="3" Margin="0,0,0,12">

                            <!-- ── CPU CARD ── -->
                            <Border Background="{DynamicResource DynamicCardBg}"
                                    CornerRadius="14"
                                    Margin="5"
                                    Padding="12"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DynamicBorderBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Style="{StaticResource IconBox}" Background="#150EA5E9">
                                            <TextBlock Text="&#xE950;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource DynamicAccent}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource CPU}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DynamicMainText}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <TextBlock x:Name="lblCpu"
                                               Text="--"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"
                                               Foreground="{DynamicResource DynamicAccent}"
                                               MaxHeight="28"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource MaxSpeed}"  Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text="{DynamicResource Cores}"     Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text="{DynamicResource Threads}"   Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text="{DynamicResource Temp}"      Style="{StaticResource FieldLabel}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="runCpuSpeed"   Text="--" Style="{StaticResource FieldValue}"/>
                                            <TextBlock x:Name="runCpuCores"   Text="--" Style="{StaticResource FieldValue}"/>
                                            <TextBlock x:Name="runCpuThreads" Text="--" Style="{StaticResource FieldValue}"/>
                                            <TextBlock x:Name="runCpuTemp"    Text="--" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ── GPU CARD ── -->
                            <Border Background="{DynamicResource DynamicCardBg}"
                                    CornerRadius="14"
                                    Margin="5"
                                    Padding="12"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DynamicBorderBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Style="{StaticResource IconBox}" Background="#15EF4444">
                                            <TextBlock Text="&#xE7F4;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource DynamicWarning}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource GraphicCard}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DynamicMainText}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <TextBlock x:Name="runGpuMainName"
                                               Text="--"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="{DynamicResource DynamicAccent}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource VRAM}" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text="{DynamicResource Temp}" Style="{StaticResource FieldLabel}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="runGpuMainVram" Text="--" Style="{StaticResource FieldValue}"/>
                                            <TextBlock x:Name="runGpuMainTemp" Text="--" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Secondary GPU -->
                                    <StackPanel x:Name="pnlGpuSecondary" Visibility="Collapsed">
                                        <Separator Margin="0,8,0,4"
                                                   Background="{DynamicResource DynamicBorderBrush}"/>
                                        <TextBlock x:Name="runGpuSecName"
                                                   Text="{DynamicResource SecondaryGPU}"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource DynamicAccent}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource VRAM}" Style="{StaticResource FieldLabel}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="runGpuSecVram" Text="--" Style="{StaticResource FieldValue}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ── DISPLAY CARD ── -->
                            <Border Background="{DynamicResource DynamicCardBg}"
                                    CornerRadius="14"
                                    Margin="5"
                                    Padding="12"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DynamicBorderBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Style="{StaticResource IconBox}" Background="#15A855F7">
                                            <TextBlock Text="&#xE7C4;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource DynamicViolet}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Display}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DynamicMainText}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource PrimaryMonitor}"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Margin="0,0,0,6"
                                               Foreground="{DynamicResource DynamicAccent}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Resolution}"  Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text="{DynamicResource RefreshRate}" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text="{DynamicResource ColorDepth}"  Style="{StaticResource FieldLabel}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="lblRes"        Text="--" Style="{StaticResource FieldValue}"/>
                                            <TextBlock x:Name="lblHz"         Text="--" Style="{StaticResource FieldValue}"/>
                                            <TextBlock x:Name="runColorDepth" Text="--" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <!-- ════════════════════════════════════════ -->
                        <!-- ROW 3 ▸ BIOS + OS CARDS                  -->
                        <!-- ════════════════════════════════════════ -->
                        <UniformGrid Columns="2">

                            <!-- ── BIOS / BOARD CARD ── -->
                            <Border Background="{DynamicResource DynamicCardBg}"
                                    CornerRadius="14"
                                    Margin="5,0,3,0"
                                    Padding="12"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DynamicBorderBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Style="{StaticResource IconBox}" Background="#15D946EF">
                                            <TextBlock Text="&#xE779;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource DynamicFuchsia}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource SystemBIOS}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DynamicMainText}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Manufacturer}" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="runBoardMan"   Text="--" Style="{StaticResource FieldValue}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource SystemModel}"  Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="runSysModel"   Text="--" Style="{StaticResource FieldValue}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource BoardModel}"   Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="runBoardProd"  Text="--" Style="{StaticResource FieldValue}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource BoardSerial}"  Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="runBoardSerial" Text="--" Style="{StaticResource FieldValue}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource BIOSSerial}"   Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="runBiosSerial" Text="--" Style="{StaticResource FieldValue}"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource BIOSDate}"     Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="runBiosDate"   Text="--" Style="{StaticResource FieldValue}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ── OS CARD ── -->
                            <Border Background="{DynamicResource DynamicCardBg}"
                                    CornerRadius="14"
                                    Margin="3,0,5,0"
                                    Padding="12"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DynamicBorderBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Style="{StaticResource IconBox}" Background="#156366F1">
                                            <TextBlock Text="&#xE2AF;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource DynamicIndigo}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource OperatingSystem}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DynamicMainText}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <TextBlock x:Name="lblWin"
                                               Text="--"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{DynamicResource DynamicAccent}"
                                               Margin="0,0,0,6"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource OSVersion}"   Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="runWinBuild" Text="--" Style="{StaticResource FieldValue}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource HostName}"    Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="runHost"     Text="--" Style="{StaticResource FieldValue}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource ActiveUser}"  Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="runUser"     Text="--" Style="{StaticResource FieldValue}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource MACAddress}"  Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="runMac"      Text="--" Style="{StaticResource FieldValue}"/>

                                        <!-- ✅ IP Address section - NEW VERSION WITHOUT BLUR EFFECT -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" 
                                                   Text="{DynamicResource IPAddress}" 
                                                   Style="{StaticResource FieldLabel}"/>

                                        <StackPanel Grid.Row="4" Grid.Column="1" 
                                                    Orientation="Horizontal" 
                                                    VerticalAlignment="Center">

                                            <!-- ✅ Container للـ IP مع Mask ديناميكي -->
                                            <Grid VerticalAlignment="Center">

                                                <!-- النص الأصلي للـ IP -->
                                                <TextBlock x:Name="runIp"
                                                           Text="--"
                                                           Style="{StaticResource FieldValue}"
                                                           Foreground="{DynamicResource DynamicMainText}"
                                                           VerticalAlignment="Center"/>

                                                <!-- ✅ Mask Rectangle - يتحكم في الإخفاء/الإظهار بدلاً من BlurEffect -->
                                                <Rectangle x:Name="IpMaskRect"
                                                           Fill="{DynamicResource DynamicCardBg}"
                                                           Opacity="1"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Stretch"
                                                           IsHitTestVisible="False"/>
                                            </Grid>

                                            <!-- زرار العين لتبديل الرؤية -->
                                            <ToggleButton x:Name="btnToggleIpVisibility"
                                                          Style="{StaticResource ToggleEyeButton}"
                                                          Margin="6,0,0,0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="False"
                                                          Click="ToggleIpVisibility_Click"
                                                          ToolTip="{DynamicResource ShowHideIP}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                    </StackPanel>
                </ScrollViewer>

                <!-- ── FOOTER ── -->
                <Border Grid.Row="2"
                        Background="{DynamicResource DynamicCardBg}"
                        CornerRadius="14"
                        Padding="14,12"
                        Margin="5,12,5,0"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource DynamicBorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Clock -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE823;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{DynamicResource DynamicAccent}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblTimeClock"
                                       Text="--"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DynamicMainText}"
                                       VerticalAlignment="Center"
                                       Width="85"
                                       TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Rectangle Grid.Column="1"
                                   Width="1" Height="18"
                                   Fill="{DynamicResource DynamicBorderBrush}"
                                   Margin="14,0"
                                   VerticalAlignment="Center"/>

                        <!-- Date -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE787;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{DynamicResource DynamicAccent}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblFullDate"
                                       Text="--"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DynamicMainText}"
                                       VerticalAlignment="Center"
                                       Width="180"
                                       TextAlignment="Left"/>
                        </StackPanel>

                        <!-- Install Button -->
                        <Button x:Name="btnInstallApps"
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ModernGradientBtn}"
                                Click="btnGoToInstall_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource InstallApps}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                                <TextBlock Text="  " Foreground="White"/>
                                <TextBlock Text="&#xE118;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="White"
                                           FontSize="15"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </Grid>

            <!-- ============================================ -->
            <!-- LOADING OVERLAY                              -->
            <!-- ============================================ -->
            <Border x:Name="LoadingOverlay"
                    Background="{DynamicResource DynamicWindowBg}"
                    CornerRadius="20"
                    Visibility="Collapsed">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                        <!-- Spinning Dots -->
                        <Grid Width="70" Height="70" Margin="0,0,0,20">
                            <Grid.Resources>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Width" Value="11"/>
                                    <Setter Property="Height" Value="11"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                </Style>
                            </Grid.Resources>

                            <Grid x:Name="DotContainer1" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform/>
                                </Grid.RenderTransform>
                                <Ellipse Fill="{DynamicResource DynamicAccent}"/>
                            </Grid>
                            <Grid x:Name="DotContainer2" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform/>
                                </Grid.RenderTransform>
                                <Ellipse Fill="{DynamicResource DynamicBlueLight}"/>
                            </Grid>
                            <Grid x:Name="DotContainer3" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform/>
                                </Grid.RenderTransform>
                                <Ellipse Fill="{DynamicResource DynamicBlueMedium}"/>
                            </Grid>
                            <Grid x:Name="DotContainer4" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform/>
                                </Grid.RenderTransform>
                                <Ellipse Fill="{DynamicResource DynamicBlueViolet}"/>
                            </Grid>
                            <Grid x:Name="DotContainer5" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform/>
                                </Grid.RenderTransform>
                                <Ellipse Fill="{DynamicResource DynamicPurpleLight}"/>
                            </Grid>

                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="DotContainer1"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:2" BeginTime="0:0:0.0">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="DotContainer2"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:2" BeginTime="0:0:0.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="DotContainer3"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:2" BeginTime="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="DotContainer4"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:2" BeginTime="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="DotContainer5"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:2" BeginTime="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                        </Grid>

                        <!-- App Name -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource ShortName}"
                                       FontSize="38"
                                       FontWeight="ExtraBold"
                                       TextAlignment="Center">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0EA5E9" Offset="0"/>
                                        <GradientStop Color="#3B82F6" Offset="0.5"/>
                                        <GradientStop Color="#8B5CF2" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                                                      Opacity="0.25" Color="#0EA5E9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource InitializingDashboard}"
                                       Margin="0,10,0,0"
                                       TextAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource DynamicSubText}"
                                       Opacity="0.85"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Designer Signature -->
                    <StackPanel VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,18">
                        <Border x:Name="DesignerSignature"
                                Cursor="Hand"
                                ToolTip="Visit Developer Portfolio"
                                Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0EA5E9" Offset="0"/>
                                            <GradientStop Color="#3B82F6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource CraftedBy}"    FontSize="9" FontWeight="Medium" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center" Opacity="0.8"/>
                                    <TextBlock Text="•" FontSize="9" Foreground="{DynamicResource DynamicSubText}" Margin="5,0,5,0" VerticalAlignment="Center" Opacity="0.5"/>
                                    <TextBlock Text="{DynamicResource DeveloperName}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0EA5E9" Offset="0"/>
                                                <GradientStop Color="#3B82F6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource SoftwareEngineer}" FontSize="9" Foreground="{DynamicResource DynamicSubText}" Margin="5,0,0,0" VerticalAlignment="Center" Opacity="0.7"/>
                                </StackPanel>
                                <Border Width="18" Height="2" Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0EA5E9" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Width="110" Height="2" CornerRadius="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0EA5E9" Offset="0"/>
                                    <GradientStop Color="#3B82F6" Offset="0.5"/>
                                    <GradientStop Color="#8B5CF2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.6" To="1"
                                                             Duration="0:0:1.5"
                                                             AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>
    </Border>
</Page>