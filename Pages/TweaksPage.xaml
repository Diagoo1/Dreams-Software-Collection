<Page x:Class="Dreams.TweaksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1024"
      Title="{DynamicResource TweaksTitle}"
      FlowDirection="{DynamicResource ApplicationFlowDirection}"
      Loaded="TweaksPage_Loaded"
      Unloaded="TweaksPage_Unloaded">
    <Page.Resources>
        <!-- Risk Colors -->
        <SolidColorBrush x:Key="RiskSafeBrush"     Color="#10B981"/>
        <SolidColorBrush x:Key="RiskCautionBrush"  Color="#F59E0B"/>
        <SolidColorBrush x:Key="RiskRiskyBrush"    Color="#EF4444"/>
        <SolidColorBrush x:Key="RiskSafeBgBrush"   Color="#1010B981"/>
        <SolidColorBrush x:Key="RiskCautionBgBrush" Color="#15F59E0B"/>
        <SolidColorBrush x:Key="RiskRiskyBgBrush"  Color="#15EF4444"/>
        <!-- Effects -->
        <DropShadowEffect x:Key="CardShadow"  BlurRadius="15" ShadowDepth="0" Opacity="0.08" Color="#000000"/>
        <DropShadowEffect x:Key="TabShadow"   BlurRadius="8"  ShadowDepth="0" Opacity="0.15" Color="Black"/>

        <!-- ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Margin" Value="0,4,2,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbRect" Background="{DynamicResource DynamicAccent}" CornerRadius="4" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbRect" Property="Background" Value="#0284C7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbRect" Property="Background" Value="#0369A1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Modern Card (Stats Cards) -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background"       Value="{DynamicResource DynamicCardBg}"/>
            <Setter Property="CornerRadius"     Value="16"/>
            <Setter Property="Padding"          Value="16"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource DynamicBorder}"/>
            <Setter Property="Effect"           Value="{StaticResource CardShadow}"/>
        </Style>
        <!-- Toggle Switch -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsChecked"        Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26">
                            <Border x:Name="Track" CornerRadius="13" Background="#35808080" BorderThickness="0">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" CenterX="23" CenterY="13"/>
                                </Border.RenderTransform>
                            </Border>
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource DynamicAccent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.X)"
                                                             To="20" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="True"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Tweak Item Card (new style) -->
        <Style x:Key="TweakItemStyle" TargetType="Border">
            <Setter Property="Background"          Value="{DynamicResource DynamicCardBg}"/>
            <Setter Property="CornerRadius"        Value="12"/>
            <Setter Property="Padding"             Value="14"/>
            <Setter Property="Margin"              Value="5"/>
            <Setter Property="VerticalAlignment"   Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="BorderBrush"         Value="{DynamicResource DynamicBorder}"/>
            <Setter Property="Opacity"             Value="0.98"/>
        </Style>
        <!-- Risk Tag -->
        <Style x:Key="RiskTagStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding"      Value="7,3"/>
        </Style>
        <!-- Action Button (Stats Cards) -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="Padding"        Value="12,7"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Segmented Tab -->
        <Style x:Key="SegmentedTabStyle" TargetType="RadioButton">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin"           Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="14,9"
                                BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TabIcon"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"   Value="{DynamicResource DynamicCardBg}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush"  Value="{DynamicResource DynamicBorder}"/>
                                <Setter TargetName="TabBorder" Property="Effect"       Value="{StaticResource TabShadow}"/>
                                <Setter Property="Foreground"                          Value="{DynamicResource DynamicAccent}"/>
                                <Setter TargetName="TabIcon"   Property="Foreground"   Value="{DynamicResource DynamicAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <!-- Root -->
    <Border Background="{DynamicResource DynamicWindowBg}" CornerRadius="20"
        BorderBrush="{DynamicResource DynamicBorder}" BorderThickness="1"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        RenderOptions.ClearTypeHint="Enabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="{DynamicResource TweaksTitle}"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource DynamicMainText}"/>
            <!-- Stats Cards -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Card 1 – Windows Activation -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="14">
                    <Grid>
                        <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets" FontSize="45"
                                   Foreground="{DynamicResource DynamicWarning}" Opacity="0.15"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,0,8"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#20F97316" Width="36" Height="36" CornerRadius="10">
                                    <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{DynamicResource DynamicWarning}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource WindowsActivation}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{DynamicResource DynamicSubText}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ActivationDot" Width="10" Height="10"
                                         Fill="{DynamicResource DynamicWarning}" Margin="0,0,10,0"/>
                                <TextBlock x:Name="lblActivationStatus" Text="--"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource DynamicMainText}"/>
                            </StackPanel>
                            <TextBlock x:Name="lblActivationDate" Text="" FontSize="9"
                                       Foreground="{DynamicResource DynamicSubText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <!-- Activate button – positioned top-right inside the card -->
                        <Button x:Name="btnActivateWindows"
                                Content="{DynamicResource Activate}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{DynamicResource DynamicWarning}"
                                Style="{StaticResource ActionBtn}"
                                Click="btnActivateWindows_Click"/>
                    </Grid>
                </Border>
                <!-- Card 2 – Processes & Services -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="14">
                    <Grid>
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="45"
                                   Foreground="{DynamicResource DynamicPurple}" Opacity="0.15"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,0,8"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#208B5CF6" Width="36" Height="36" CornerRadius="10">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{DynamicResource DynamicPurple}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource ProcessesServices}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{DynamicResource DynamicSubText}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="lblProcServCount" Text="-- / --"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource DynamicMainText}"/>
                            <TextBlock x:Name="lblProcServDesc" Text="{DynamicResource CurrentlyActive}"
                                       FontSize="9" Foreground="{DynamicResource DynamicSubText}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Card 3 – Tweaks Stats -->
                <Border Grid.Column="4" Style="{StaticResource ModernCard}" Padding="14">
                    <Grid>
                        <TextBlock Text="&#xE15E;" FontFamily="Segoe MDL2 Assets" FontSize="45"
                                   Foreground="{DynamicResource DynamicAccent}" Opacity="0.15"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,0,8"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#200EA5E9" Width="36" Height="36" CornerRadius="10">
                                    <TextBlock Text="&#xE15E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{DynamicResource DynamicAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource TweaksStats}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{DynamicResource DynamicSubText}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="lblTweaksCount" Text="0 / 0"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource DynamicMainText}"/>
                            <TextBlock x:Name="lblTweaksDesc" Text="{DynamicResource EnabledOutOfTotal}"
                                       FontSize="9" Foreground="{DynamicResource DynamicSubText}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <!-- Tabs Bar -->
            <Border Grid.Row="4" Background="{DynamicResource DynamicHoverBg}"
                    CornerRadius="10" Padding="5" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="tabGeneral"  GroupName="Tabs" Style="{StaticResource SegmentedTabStyle}"
                                 Content="{DynamicResource Tab_General}"              Tag="&#xE713;" IsChecked="True" Checked="TabGeneral_Checked"/>
                    <RadioButton x:Name="tabGaming"   GroupName="Tabs" Style="{StaticResource SegmentedTabStyle}"
                                 Content="{DynamicResource Tab_Gaming}"               Tag="&#xE7FC;" Checked="TabGaming_Checked"/>
                    <RadioButton x:Name="tabUI"       GroupName="Tabs" Style="{StaticResource SegmentedTabStyle}"
                                 Content="{DynamicResource Tab_UI}"                   Tag="&#xE7F9;" Checked="TabUI_Checked"/>
                    <RadioButton x:Name="tabServices" GroupName="Tabs" Style="{StaticResource SegmentedTabStyle}"
                                 Content="{DynamicResource Tab_Services}"             Tag="&#xE945;" Checked="TabServices_Checked"/>
                    <RadioButton x:Name="tabPrivacy"  GroupName="Tabs" Style="{StaticResource SegmentedTabStyle}"
                                 Content="{DynamicResource Tab_Privacy}"              Tag="&#xE72E;" Checked="TabPrivacy_Checked"/>
                    <RadioButton x:Name="tabNetwork"  GroupName="Tabs" Style="{StaticResource SegmentedTabStyle}"
                                 Content="{DynamicResource Tab_Network}"              Tag="&#xE770;" Checked="TabNetwork_Checked"/>
                </StackPanel>
            </Border>
            <!-- Content Area -->
            <Grid Grid.Row="6">
                <!-- ===== General Tab ===== -->
                <ScrollViewer x:Name="contentGeneral" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource TweakItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="{DynamicResource Tweak_DebloatWindows_Name}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{DynamicResource DynamicMainText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource RiskTagStyle}" Background="{StaticResource RiskSafeBgBrush}">
                                                <TextBlock Text="{DynamicResource Risk_Safe}" Foreground="{StaticResource RiskSafeBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Tweak_DebloatWindows_Desc}"
                                                   FontSize="11" Foreground="{DynamicResource DynamicSubText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                              Tag="DebloatWindows" Checked="TweaksCountUpdated" Unchecked="TweaksCountUpdated" IsChecked="False"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource TweakItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="{DynamicResource Tweak_DisableTelemetry_Name}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{DynamicResource DynamicMainText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource RiskTagStyle}" Background="{StaticResource RiskSafeBgBrush}">
                                                <TextBlock Text="{DynamicResource Risk_Safe}" Foreground="{StaticResource RiskSafeBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Tweak_DisableTelemetry_Desc}"
                                                   FontSize="11" Foreground="{DynamicResource DynamicSubText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                              Tag="DisableTelemetry" Checked="TweaksCountUpdated" Unchecked="TweaksCountUpdated" IsChecked="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource TweakItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="{DynamicResource Tweak_DisableCopilot_Name}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{DynamicResource DynamicMainText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource RiskTagStyle}" Background="{StaticResource RiskSafeBgBrush}">
                                                <TextBlock Text="{DynamicResource Risk_Safe}" Foreground="{StaticResource RiskSafeBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Tweak_DisableCopilot_Desc}"
                                                   FontSize="11" Foreground="{DynamicResource DynamicSubText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                              Tag="DisableCopilot" Checked="TweaksCountUpdated" Unchecked="TweaksCountUpdated" IsChecked="False"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource TweakItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="{DynamicResource Tweak_DetailedBSOD_Name}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{DynamicResource DynamicMainText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource RiskTagStyle}" Background="{StaticResource RiskSafeBgBrush}">
                                                <TextBlock Text="{DynamicResource Risk_Safe}" Foreground="{StaticResource RiskSafeBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Tweak_DetailedBSOD_Desc}"
                                                   FontSize="11" Foreground="{DynamicResource DynamicSubText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                              Tag="DetailedBSOD" Checked="TweaksCountUpdated" Unchecked="TweaksCountUpdated" IsChecked="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource TweakItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="{DynamicResource Tweak_DisableKernelIsolation_Name}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{DynamicResource DynamicMainText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource RiskTagStyle}" Background="{StaticResource RiskRiskyBgBrush}">
                                                <TextBlock Text="{DynamicResource Risk_Risky}" Foreground="{StaticResource RiskRiskyBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
