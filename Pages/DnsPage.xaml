                                    <Border Style="{StaticResource TagStyle}" Background="#158B5CF6">
                                        <TextBlock Text="{DynamicResource Tag_Filtering}" FontSize="9" Foreground="{DynamicResource DynamicPurple}"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}" Background="#1510B981">
                                        <TextBlock Text="{DynamicResource Tag_Security}" FontSize="9" Foreground="#10B981"/>
                                    </Border>
                                </WrapPanel>
                                <Border x:Name="selectedOpenDNS" Grid.RowSpan="4" Width="4" Background="{DynamicResource DynamicAccent}" CornerRadius="2" HorizontalAlignment="Left" Margin="-17,0,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- ──────── QUAD9 ──────── -->
                        <Border x:Name="cardQuad9"
                                Style="{StaticResource DnsCard}"
