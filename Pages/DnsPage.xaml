                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource IPBox}" Margin="0,0,0,10">
                                    <TextBlock Text="{DynamicResource DnsProvider_Quad9_Ip}" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="2" Text="{DynamicResource DnsProvider_Quad9_Info}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="16"/>
                                <WrapPanel Grid.Row="3" VerticalAlignment="Bottom">
                                    <Border Style="{StaticResource TagStyle}" Background="#1510B981">
                                        <TextBlock Text="{DynamicResource Tag_Security}" FontSize="9" Foreground="#10B981"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}" Background="#15EF4444">
                                        <TextBlock Text="{DynamicResource Tag_ThreatBlocking}" FontSize="9" Foreground="#EF4444"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}" Background="#1514B8A6">
                                        <TextBlock Text="{DynamicResource Tag_Privacy}" FontSize="9" Foreground="{DynamicResource DynamicTeal}"/>
                                    </Border>
                                </WrapPanel>
                                <Border x:Name="selectedQuad9" Grid.RowSpan="4" Width="4" Background="{DynamicResource DynamicAccent}" CornerRadius="2" HorizontalAlignment="Left" Margin="-17,0,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- ──────── ADGUARD ──────── -->
                        <Border x:Name="cardAdGuard"
                                Style="{StaticResource DnsCard}"
                                MouseLeftButtonDown="Card_Click"
                                MouseEnter="Card_MouseEnter"
                                MouseLeave="Card_MouseLeave"
                                Tag="AdGuard">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#15EC4899">
                                        <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DynamicPink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource DnsProvider_AdGuard_Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource DynamicMainText}"/>
                                        <TextBlock Text="{DynamicResource DnsProvider_AdGuard_Desc}" FontSize="10" Foreground="{DynamicResource DynamicSubText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="pingAdGuard" Text="{DynamicResource Text_LatencyPlaceholder}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Right"/>
                                        <Border Height="3" Width="40" CornerRadius="2" Background="{DynamicResource DynamicBorder}" Margin="0,4,0,0">
                                            <Border x:Name="pingBarAdGuard" Width="0" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource DynamicSuccess}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource IPBox}" Margin="0,0,0,10">
                                    <TextBlock Text="{DynamicResource DnsProvider_AdGuard_Ip}" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="2" Text="{DynamicResource DnsProvider_AdGuard_Info}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="16"/>
                                <WrapPanel Grid.Row="3" VerticalAlignment="Bottom">
                                    <Border Style="{StaticResource TagStyle}" Background="#1510B981">
                                        <TextBlock Text="{DynamicResource Tag_AdBlock}" FontSize="9" Foreground="#10B981"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}" Background="#15EF4444">
                                        <TextBlock Text="{DynamicResource Tag_MalwareBlock}" FontSize="9" Foreground="#EF4444"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}" Background="#1514B8A6">
                                        <TextBlock Text="{DynamicResource Tag_Privacy}" FontSize="9" Foreground="{DynamicResource DynamicTeal}"/>
                                    </Border>
                                </WrapPanel>
                                <Border x:Name="selectedAdGuard" Grid.RowSpan="4" Width="4" Background="{DynamicResource DynamicAccent}" CornerRadius="2" HorizontalAlignment="Left" Margin="-17,0,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- ──────── DHCP ──────── -->
                        <Border x:Name="cardDHCP"
                                Style="{StaticResource DnsCard}"
                                MouseLeftButtonDown="Card_Click"
                                MouseEnter="Card_MouseEnter"
                                MouseLeave="Card_MouseLeave"
                                Tag="DHCP">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#156B7280">
                                        <TextBlock Text="&#xE77C;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource DnsProvider_Dhcp_Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource DynamicMainText}"/>
                                        <TextBlock Text="{DynamicResource DnsProvider_Dhcp_Desc}" FontSize="10" Foreground="{DynamicResource DynamicSubText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="pingDHCP" Text="{DynamicResource Text_NotAvailable}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Right"/>
                                        <Border Height="3" Width="40" CornerRadius="2" Background="{DynamicResource DynamicBorder}" Margin="0,4,0,0">
                                            <Border x:Name="pingBarDHCP" Width="0" HorizontalAlignment="Left" CornerRadius="2" Background="#6B7280"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource IPBox}" Margin="0,0,0,10">
