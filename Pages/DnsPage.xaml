                                </Border>
                                <TextBlock Grid.Row="2" Text="{DynamicResource DnsProvider_Dhcp_Info}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="16"/>
                                <WrapPanel Grid.Row="3" VerticalAlignment="Bottom">
                                    <Border Style="{StaticResource TagStyle}" Background="#156B7280">
                                        <TextBlock Text="{DynamicResource Tag_Default}" FontSize="9" Foreground="#6B7280"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}" Background="#156B7280">
                                        <TextBlock Text="{DynamicResource Tag_IspProvided}" FontSize="9" Foreground="#6B7280"/>
                                    </Border>
                                </WrapPanel>
                                <Border x:Name="selectedDHCP" Grid.RowSpan="4" Width="4" Background="{DynamicResource DynamicAccent}" CornerRadius="2" HorizontalAlignment="Left" Margin="-17,0,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                    </UniformGrid>
                </Grid>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   CUSTOM DNS BUTTON                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="4" Margin="0,8,5,0" Background="Transparent">
                <Border x:Name="cardCustom"
                        Height="54"
                        Background="{DynamicResource DynamicCardBg}"
                        CornerRadius="14"
                        BorderThickness="1.5"
                        BorderBrush="{DynamicResource DynamicBorder}"
                        Cursor="Hand"
                        MouseLeftButtonDown="CardCustom_MouseDown"
                        MouseEnter="CardCustom_MouseEnter"
                        MouseLeave="CardCustom_MouseLeave">
                    <Grid Background="Transparent">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <Border Width="34" Height="34" CornerRadius="10" 
                                    Background="{DynamicResource DynamicHoverBg}">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource DynamicAccent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Btn_CustomDns}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource DynamicMainText}" Margin="12,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Btn_CustomDns_Desc}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource DynamicAccent}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

        </Grid>
    </Border>
</Page>