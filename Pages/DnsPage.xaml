<Page x:Class="Dreams.Pages.DnsPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="768" d:DesignWidth="1024" 
      Title="{DynamicResource DnsPage_Title}" 
      FlowDirection="{DynamicResource ApplicationFlowDirection}" 
      Background="Transparent">

    <Page.Resources>

        <!-- ══════════════════════════════════════════ -->
        <!--              BUTTON STYLES                 -->
        <!-- ══════════════════════════════════════════ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DynamicAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0284C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ OutlineBtn محسّن - بدون حدود، hover خفيف -->
        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock x:Name="icon"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Tag}"/>
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#150EA5E9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#250EA5E9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" 
                                        Value="{DynamicResource DynamicHoverBg}"/>
                                <Setter Property="Foreground" 
                                        Value="{DynamicResource DynamicMainText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════ -->
        <!--              TAB FILTER CHIPS              -->
        <!-- ══════════════════════════════════════════ -->
        <Style x:Key="TabChip" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="10"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" 
                                        Value="{DynamicResource DynamicHoverBg}"/>
                                <Setter Property="Foreground" 
                                        Value="{DynamicResource DynamicMainText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A0EA5E9"/>
                                <Setter Property="Foreground" 
                                        Value="{DynamicResource DynamicAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════ -->
        <!--              DNS CARD STYLE                -->
        <!-- ══════════════════════════════════════════ -->
        <Style x:Key="DnsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DynamicCardBg}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DynamicBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="220"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="270"/>
            <Setter Property="MaxWidth" Value="350"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="IPBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DynamicTotalCardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="TagStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>

        <!-- ══════════════════════════════════════════ -->
        <!--         CUSTOM SCROLLBAR STYLE             -->
        <!-- ══════════════════════════════════════════ -->
        <Style x:Key="SlimScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" 
                                Background="{DynamicResource DynamicBorder}" 
                                Opacity="0.6" 
                                Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" 
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource SlimScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--                     ROOT CONTAINER                        -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <Border Background="{DynamicResource DynamicWindowBg}"
            CornerRadius="20"
            BorderBrush="{DynamicResource DynamicBorder}"
            BorderThickness="1">
        <Grid Margin="20,15,15,15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════ -->
            <!--               HEADER ROW               -->
            <!-- ══════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource DnsPage_Title}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DynamicMainText}"/>
                    <TextBlock Text="{DynamicResource DnsPage_Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource DynamicSubText}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- ✅ الأزرار المحسّنة مع أيقونات -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="btnFlushDns"
                            Style="{StaticResource OutlineBtn}"
                            Tag="&#xE72C;"
                            Margin="0,0,6,0"
                            Click="btnFlushDns_Click">
                        <TextBlock Text="{DynamicResource Btn_FlushDns}"/>
                    </Button>

                    <Button x:Name="btnNetworkReset"
                            Style="{StaticResource OutlineBtn}"
                            Tag="&#xE895;"
                            Click="btnNetworkReset_Click">
                        <TextBlock Text="{DynamicResource Btn_NetworkReset}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════ -->
            <!--          CURRENT DNS INFO CARD         -->
            <!-- ══════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource DynamicCardBg}"
                    CornerRadius="16"
                    Padding="20,15"
                    Margin="0,0,5,15"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource DynamicBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Label_CurrentDnsSettings}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DynamicSubText}"
                                   Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource DynamicSuccess}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtCurrentDNS"
                                       Text="{DynamicResource Text_Loading}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DynamicMainText}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border BorderBrush="{DynamicResource DynamicBorder}"
                                BorderThickness="0,0,1,0"
                                Padding="0,0,20,0"
                                Margin="0,0,20,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource Label_Latency}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource DynamicSubText}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,3"/>
                                <TextBlock x:Name="txtLatency"
                                           Text="{DynamicResource Text_LatencyPlaceholder}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource DynamicSubText}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,5,0">
                            <TextBlock Text="{DynamicResource Label_Feature}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DynamicSubText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,3"/>
                            <TextBlock x:Name="txtAdBlocking"
                                       Text="{DynamicResource Text_NotAvailable}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DynamicSubText}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════ -->
            <!--       FILTER TABS + TEST BUTTON        -->
            <!-- ══════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="0,0,0,15">
                <WrapPanel VerticalAlignment="Center">
                    <RadioButton Content="{DynamicResource Tab_AllServers}"
                                 Style="{StaticResource TabChip}"
                                 IsChecked="True"
                                 GroupName="FilterGroup"
                                 Checked="TabFilter_Checked"
                                 Tag="All"/>
                    <RadioButton Content="{DynamicResource Tab_Recommended}"
                                 Style="{StaticResource TabChip}"
                                 GroupName="FilterGroup"
                                 Checked="TabFilter_Checked"
                                 Tag="Recommended"/>
                    <RadioButton Content="{DynamicResource Tab_Fast}"
                                 Style="{StaticResource TabChip}"
                                 GroupName="FilterGroup"
                                 Checked="TabFilter_Checked"
                                 Tag="Fast"/>
                    <RadioButton Content="{DynamicResource Tab_Security}"
                                 Style="{StaticResource TabChip}"
                                 GroupName="FilterGroup"
                                 Checked="TabFilter_Checked"
                                 Tag="Security"/>
                    <RadioButton Content="{DynamicResource Tab_Privacy}"
                                 Style="{StaticResource TabChip}"
                                 GroupName="FilterGroup"
                                 Checked="TabFilter_Checked"
                                 Tag="Privacy"/>
                </WrapPanel>

                <Button x:Name="btnTestAll"
                        Content="{DynamicResource Btn_TestAllServers}"
                        Style="{StaticResource ActionBtn}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Click="btnTestAll_Click"/>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--              RESPONSIVE DNS CARDS GRID                    -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="3"
                          Style="{StaticResource SlimScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,10"
                          PanningMode="VerticalOnly">

                <Grid x:Name="DnsCardsGrid" SizeChanged="DnsCardsGrid_SizeChanged">
                    <UniformGrid x:Name="DnsCardsContainer"
                                 Columns="3"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Top">

                        <!-- ──────── GOOGLE ──────── -->
                        <Border x:Name="cardGoogle"
                                Style="{StaticResource DnsCard}"
                                MouseLeftButtonDown="Card_Click"
                                MouseEnter="Card_MouseEnter"
                                MouseLeave="Card_MouseLeave"
                                Tag="Google">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#15EF4444">
                                        <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource DnsProvider_Google_Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource DynamicMainText}"/>
                                            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FFD700" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="{DynamicResource Tab_Recommended}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="#FFD700" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource DnsProvider_Google_Desc}" FontSize="10" Foreground="{DynamicResource DynamicSubText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="pingGoogle" Text="{DynamicResource Text_LatencyPlaceholder}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Right"/>
                                        <Border Height="3" Width="40" CornerRadius="2" Background="{DynamicResource DynamicBorder}" Margin="0,4,0,0">
                                            <Border x:Name="pingBarGoogle" Width="0" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource DynamicSuccess}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource IPBox}" Margin="0,0,0,10">
                                    <TextBlock Text="{DynamicResource DnsProvider_Google_Ip}" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="2" Text="{DynamicResource DnsProvider_Google_Info}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="16"/>
                                <WrapPanel Grid.Row="3" VerticalAlignment="Bottom">
                                    <Border Style="{StaticResource TagStyle}" Background="#15EF4444">
                                        <TextBlock Text="{DynamicResource Tag_Reliable}" FontSize="9" Foreground="#EF4444"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}" Background="#15F59E0B">
                                        <TextBlock Text="{DynamicResource Tag_WidelySupported}" FontSize="9" Foreground="#F59E0B"/>
                                    </Border>
                                </WrapPanel>
                                <Border x:Name="selectedGoogle" Grid.RowSpan="4" Width="4" Background="{DynamicResource DynamicAccent}" CornerRadius="2" HorizontalAlignment="Left" Margin="-17,0,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- ──────── CLOUDFLARE ──────── -->
                        <Border x:Name="cardCloudflare"
                                Style="{StaticResource DnsCard}"
                                MouseLeftButtonDown="Card_Click"
                                MouseEnter="Card_MouseEnter"
                                MouseLeave="Card_MouseLeave"
                                Tag="Cloudflare">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#1514B8A6">
                                        <TextBlock Text="&#xE944;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DynamicTeal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource DnsProvider_Cloudflare_Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource DynamicMainText}"/>
                                            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FFD700" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="{DynamicResource Tab_Recommended}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="#FFD700" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource DnsProvider_Cloudflare_Desc}" FontSize="10" Foreground="{DynamicResource DynamicSubText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="pingCloudflare" Text="{DynamicResource Text_LatencyPlaceholder}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Right"/>
                                        <Border Height="3" Width="40" CornerRadius="2" Background="{DynamicResource DynamicBorder}" Margin="0,4,0,0">
                                            <Border x:Name="pingBarCloudflare" Width="0" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource DynamicSuccess}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource IPBox}" Margin="0,0,0,10">
                                    <TextBlock Text="{DynamicResource DnsProvider_Cloudflare_Ip}" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="2" Text="{DynamicResource DnsProvider_Cloudflare_Info}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="16"/>
                                <WrapPanel Grid.Row="3" VerticalAlignment="Bottom">
                                    <Border Style="{StaticResource TagStyle}" Background="#150EA5E9">
                                        <TextBlock Text="{DynamicResource Tag_Fast}" FontSize="9" Foreground="{DynamicResource DynamicAccent}"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}" Background="#1514B8A6">
                                        <TextBlock Text="{DynamicResource Tag_Privacy}" FontSize="9" Foreground="{DynamicResource DynamicTeal}"/>
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}" Background="#1510B981">
                                        <TextBlock Text="{DynamicResource Tag_Security}" FontSize="9" Foreground="#10B981"/>
                                    </Border>
                                </WrapPanel>
                                <Border x:Name="selectedCloudflare" Grid.RowSpan="4" Width="4" Background="{DynamicResource DynamicAccent}" CornerRadius="2" HorizontalAlignment="Left" Margin="-17,0,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- ──────── OPENDNS ──────── -->
                        <Border x:Name="cardOpenDNS"
                                Style="{StaticResource DnsCard}"
                                MouseLeftButtonDown="Card_Click"
                                MouseEnter="Card_MouseEnter"
                                MouseLeave="Card_MouseLeave"
                                Tag="OpenDNS">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#158B5CF6">
                                        <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DynamicPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource DnsProvider_OpenDns_Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource DynamicMainText}"/>
                                        <TextBlock Text="{DynamicResource DnsProvider_OpenDns_Desc}" FontSize="10" Foreground="{DynamicResource DynamicSubText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="pingOpenDNS" Text="{DynamicResource Text_LatencyPlaceholder}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Right"/>
                                        <Border Height="3" Width="40" CornerRadius="2" Background="{DynamicResource DynamicBorder}" Margin="0,4,0,0">
                                            <Border x:Name="pingBarOpenDNS" Width="0" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource DynamicSuccess}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource IPBox}" Margin="0,0,0,10">
                                    <TextBlock Text="{DynamicResource DnsProvider_OpenDns_Ip}" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="2" Text="{DynamicResource DnsProvider_OpenDns_Info}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="16"/>
