<Window x:Class="Dreams.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dreams"
        mc:Ignorable="d" Name="home"
        Title="Dreams" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="Transparent" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip" WindowState="Normal"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">

    <Window.Resources>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       FontSize="14" Foreground="#EF4444"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AEF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       FontSize="16" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarMenuButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" HorizontalAlignment="Stretch">

                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="10" Margin="8,2"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="bdScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                            </Border>

                            <Grid x:Name="contentGrid" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="contentScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="txtIcon"
                                           Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           Width="22"/>

                                <TextBlock x:Name="txtContent"
                                           Grid.Column="1"
                                           Text="{TemplateBinding Content}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,20,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           Visibility="Collapsed"
                                           Opacity="0"/>
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="contentScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.93" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="contentScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.93" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="bdScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.93" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="bdScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.93" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="bd"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.8" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="contentScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="contentScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="bdScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="bdScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="bd"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <DataTrigger Binding="{Binding IsChecked, ElementName=btnMenu}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="txtContent"
                                                                           Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{x:Static Visibility.Visible}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="txtContent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1"
                                                             BeginTime="0:0:0.15"
                                                             Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="txtContent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.1"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="txtContent"
                                                                           Storyboard.TargetProperty="Visibility"
                                                                           BeginTime="0:0:0.1">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{x:Static Visibility.Collapsed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Margin="8,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE700;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource DynamicMainText}"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource DynamicWindowBg}"
            BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border x:Name="sideBar"
                    Background="{DynamicResource DynamicSidebarBg}"
                    CornerRadius="12,0,0,12"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource DynamicBorderBrush}"
                    Width="70"
                    HorizontalAlignment="Left">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Hamburger Menu Button -->
                    <ToggleButton x:Name="btnMenu" Grid.Row="0" Style="{StaticResource MenuToggleStyle}">
                        <ToggleButton.Triggers>
                            <EventTrigger RoutedEvent="ToggleButton.Checked">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sideBar"
                                                         Storyboard.TargetProperty="Width"
                                                         To="220" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sideBar"
                                                         Storyboard.TargetProperty="Width"
                                                         To="70" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ToggleButton.Triggers>
                    </ToggleButton>

                    <!-- Sidebar Items -->
                    <StackPanel x:Name="MenuStack" Grid.Row="1" VerticalAlignment="Center">
                        <RadioButton IsChecked="True" Content="{DynamicResource Dashboard}"
                 Style="{StaticResource SidebarMenuButton}"
                 Tag="&#xE80F;" Click="Home_btn"/>
                        <RadioButton Content="{DynamicResource Installer}"
                 Style="{StaticResource SidebarMenuButton}"
                 Tag="&#xF158;" Click="Install_btn"/>
                        <RadioButton Content="{DynamicResource AppStore}"
                 Style="{StaticResource SidebarMenuButton}"
                 Tag="&#xE896;" Click="Online_btn"/>
                        <RadioButton Content="{DynamicResource Optimizer}"
                 Style="{StaticResource SidebarMenuButton}"
                 Tag="&#xE945;" Click="Optimize_btn"/>
                        <RadioButton Content="{DynamicResource Tweaks}"
                 Style="{StaticResource SidebarMenuButton}"
                 Tag="&#xE90F;" Click="Tweaks_btn"/>
                        <RadioButton Content="{DynamicResource DNS}"
                 Style="{StaticResource SidebarMenuButton}"
                 Tag="&#xEE77;" Click="DNS_btn"/>
                        <RadioButton Content="{DynamicResource About}"
                 Style="{StaticResource SidebarMenuButton}"
                 Tag="&#xE946;" PreviewMouseDown="About_btn_Preview"/>
                    </StackPanel>

                    <!-- Settings Button -->
                    <RadioButton Grid.Row="2" x:Name="rbSettings" Content="{DynamicResource Settings}"
             Style="{StaticResource SidebarMenuButton}"
             Tag="&#xE713;"
             Margin="0,-12,0,8"
             PreviewMouseDown="Settings_btn_Preview"/>
                </Grid>
            </Border>

            <!-- الـ Indicator خارج الـ sideBar تماماً — فوق كل حاجة في الـ Grid الرئيسي -->
            <!-- ده بيحل مشكلة الـ CornerRadius clip اللي كانت بتقص الـ indicator -->
            <Border x:Name="ActiveIndicator"
                    Grid.Column="0"
                    Width="4" Height="24"
                    Background="{DynamicResource DynamicAccent}"
                    CornerRadius="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="3,0,0,0"
                    IsHitTestVisible="False"
                    Panel.ZIndex="99">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="IndicatorTransform" Y="0"/>
                </Border.RenderTransform>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Grid Grid.Row="0">

                    <!-- ✅ TEXTBLOCK WITHOUT SHADOW -->
                    <TextBlock x:Name="lblCurrentPage" 
                               Text="{DynamicResource Dashboard}"
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DynamicMainText}"
                               VerticalAlignment="Center" 
                               Margin="20,0,0,0"
                               Opacity="1"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,10,0">

                        <Button x:Name="btnAlwaysOnTop" Style="{StaticResource IconButton}"
                                Content="&#xE840;" ToolTip="Always on Top" Click="ToggleAlwaysOnTop"/>

                        <Button x:Name="btnTheme" Style="{StaticResource IconButton}"
                                Content="&#xE708;" ToolTip="Toggle Theme" Click="ToggleTheme"/>

                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="btnMinimize_Click"/>

                        <!-- ✅ Restore/Maximize button - Content updated dynamically from code-behind -->
                        <Button x:Name="btnRestore" Style="{StaticResource IconButton}" 
                                Content="&#xE922;" Click="btnRestore_Click" Margin="5,0"
                                ToolTip="Maximize"/>

                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="btnClose_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Frame لعرض الصفحات -->
                <Border Grid.Row="1" Margin="15,0,15,15">
                    <Frame x:Name="PagesNavigation" 
                           NavigationUIVisibility="Hidden" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>